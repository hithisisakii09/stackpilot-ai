{
  "name": "stackpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:data": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs && npm run check:data && npm run build && npm run check:build && npm run release:preflight",
    "check:build": "node scripts/check-build.mjs",
    "research:queue": "node scripts/research-queue.mjs",
    "research:evidence": "node scripts/evidence-report.mjs",
    "ops:report": "node scripts/ops-report.mjs",
    "partners:queue": "node scripts/affiliate-readiness-report.mjs",
    "ops:backlog": "node scripts/operating-backlog.mjs",
    "research:claims": "node scripts/research-claims-report.mjs",
    "publisher:readiness": "node scripts/publisher-readiness-report.mjs",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "dependencies": {
    "astro": "^7.4.4"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
