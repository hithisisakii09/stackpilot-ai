{
  "name": "stackpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:data": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs && npm run check:data && npm run build && npm run check:build && npm run release:preflight",
    "check:build": "node scripts/check-build.mjs",
    "research:queue": "node scripts/research-queue.mjs",
    "research:evidence": "node scripts/evidence-report.mjs",
    "ops:report": "node scripts/ops-report.mjs",
    "partners:queue": "node scripts/affiliate-readiness-report.mjs",
    "ops:backlog": "node scripts/operating-backlog.mjs",
    "research:claims": "node scripts/research-claims-report.mjs",
    "publisher:readiness": "node scripts/publisher-readiness-report.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "research:comparisons": "node scripts/comparison-evidence-report.mjs",
    "release:readiness": "node scripts/production-readiness-report.mjs",
    "research:source-risk": "node scripts/candidate-source-risk-report.mjs",
    "research:review-packets": "node scripts/comparison-review-packets.mjs",
    "research:review-history": "node scripts/editorial-review-history-report.mjs",
    "editorial:authorization": "node scripts/editorial-authorization-report.mjs",
    "research:evidence-captures": "node scripts/comparison-evidence-captures-report.mjs",
    "research:gap-worklist": "node scripts/comparison-gap-worklist.mjs",
    "research:intake": "node scripts/manual-research-intake.mjs",
    "research:claim-starter": "node scripts/claim-research-starter.mjs",
    "research:snapshot-check": "node scripts/offline-snapshot-consistency.mjs"
