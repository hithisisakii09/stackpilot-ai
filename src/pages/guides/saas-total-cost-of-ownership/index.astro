---
import { compareSubscriptionCosts, formatMinorUnits } from '../../../lib/cost-comparison.mjs';

const inputs = {
  currency:'USD',
  months:12,
  optionA:{flatMonthly:'20.00',seatMonthly:'10.00',seats:'5',extrasMonthly:'5.00',oneTimeFee:'100.00'},
  optionB:{flatMonthly:'55.00',seatMonthly:'3.00',seats:'5',extrasMonthly:'8.00',oneTimeFee:'0.00'}
};
const example=compareSubscriptionCosts(inputs);
const money=value=>formatMinorUnits(value,example.currency);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="A practical SaaS total cost guide: seats, add-ons, migration, usage overages, renewals, and a clearly hypothetical cost comparison." />
  <title>Guide to SaaS total cost of ownership | StackPilot AI</title>
  <style>
    :root{font-family:system-ui,sans-serif;background:#0b1220;color:#e9f1ff;color-scheme:dark}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0}
    header,main,footer{max-width:980px;margin:auto;padding:24px}
    nav{display:flex;flex-wrap:wrap;gap:15px}
    a{color:#7ce8c6;overflow-wrap:anywhere}
    h1{font-size:clamp(34px,6vw,60px);line-height:1.12}
    h2{font-size:clamp(23px,3vw,33px);line-height:1.3}
    h3{font-size:1.16rem}
    p,li,dd{color:#c9d9ec;line-height:1.75}
    li{margin:5px 0}
    section{margin:28px 0}
    .panel{background:#152138;border:1px solid #405675;border-radius:16px;padding:24px}
    .lead{font-size:1.13rem}
    .eyebrow{color:#7ce8c6;font-weight:750}
    .notice{border-left:4px solid #7ce8c6;padding:14px 18px;background:#152138;color:#e9f1ff}
    .actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:22px}
    .button{display:inline-block;background:#7ce8c6;color:#08251d;text-decoration:none;font-weight:750;border-radius:9px;padding:13px 17px}
