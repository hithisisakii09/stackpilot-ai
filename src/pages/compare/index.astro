---
import { canonicalUrl } from '../../lib/site-origin.mjs';
import products from '../../data/products.json';
import { comparisonCategories, categoryComparisonRows } from '../../lib/comparison.mjs';

const categories = comparisonCategories(products);
// This page deliberately serializes only the already-reviewed candidate fields.
const publicCatalog = {products: products.map(({id,name,category,bestFor}) => ({id,name,category,workflowTags:bestFor,suitabilityStatus:'CANDIDATE_UNVERIFIED'}))};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow" /><link rel="canonical" href={canonicalUrl('/compare/')} />
  <meta name="description" content="Compare SaaS research candidates by category, known information and evidence gaps." />
  <title>Compare software candidates | StackPilot AI</title>
  <style>
    :root { font-family: system-ui, sans-serif; background: #0b1220; color: #e9f1ff; }
    * { box-sizing: border-box; }
    body { margin: 0; }
    header, main, footer { max-width: 1080px; margin: auto; padding: 24px; }
    a { color: #7ce8c6; }
    p, li { color: #c6d5e8; line-height: 1.7; }
    section { margin: 38px 0; }
    .table-scroll { overflow-x: auto; border: 1px solid #34455f; border-radius: 12px; }
    table { width: 100%; border-collapse: collapse; background: #152138; min-width: 640px; }
    th, td { text-align: left; padding: 16px; border-bottom: 1px solid #34455f; vertical-align: top; }
    thead th { background: #253652; }
    .notice { background: #152138; border-left: 4px solid #edc777; padding: 16px; }
    .links { display: flex; flex-wrap: wrap; gap: 18px; }
    .compare-controls { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; margin: 18px 0; }
    .compare-controls label { display: block; font-weight: 650; }
    .compare-controls select { width: 100%; display: block; margin-top: 7px; padding: 12px; background: #0b1220; color: #e9f1ff; border: 1px solid #6a819e; border-radius: 8px; }
    button { background: #7ce8c6; color: #06231d; border: 0; border-radius: 8px; padding: 12px 20px; font-weight: 700; cursor: pointer; }
    :focus-visible { outline: 3px solid #7ce8c6; outline-offset: 3px; }
    #comparison-result { margin: 22px 0; }
    :global(#comparison-result a) { color: #7ce8c6; }
    :global(#comparison-result a:focus-visible) { outline: 3px solid #7ce8c6; outline-offset: 3px; }
    .helper { font-size: .95rem; }
    #comparison-error { color: #ffe2ae; }
    @media (max-width: 700px) { .compare-controls { grid-template-columns: 1fr; } }
    .skip-link { position: absolute; top: -100px; left: 16px; background: #7ce8c6; color: #06231d; padding: 10px 16px; font-weight: 700; border-radius: 6px; z-index: 1000; text-decoration: none; }
    .skip-link:focus { top: 16px; outline: 3px solid #fff; }
  </style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <header class="links"><nav aria-label="Site navigation"><a href="/">← StackPilot AI</a><a href="/methodology/">Research methodology</a><a href="/disclosure/">Affiliate disclosure</a></nav></header>
  <main id="main">
    <h1>Compare software candidates</h1>
    <p>Compare preliminary entries <strong>within the same category</strong>. These tables show catalog descriptions, not tested feature parity or verified buyer suitability.</p>
    <p class="notice">All product claims, team fit, and current pricing remain unverified. These products are not ranked or endorsed, and there are no affiliate links.</p>

    <section aria-labelledby="featured-comparisons">
      <h2 id="featured-comparisons">Direct head-to-head comparisons</h2>
      <p>Explore dedicated, side-by-side matrices comparing common alternatives within each category:</p>
      <ul>
        <li><a href="/compare/hubspot-vs-pipedrive/">HubSpot vs Pipedrive</a> — CRM &amp; Sales workflow comparison</li>
        <li><a href="/compare/semrush-vs-ahrefs/">Semrush vs Ahrefs</a> — Search marketing &amp; backlink index comparison</li>
        <li><a href="/compare/kinsta-vs-cloudways/">Kinsta vs Cloudways</a> — Managed WordPress vs Cloud VPS comparison</li>
      </ul>
    </section>

    <section aria-labelledby="compare-title">
      <h2 id="compare-title">Choose two or three tools to compare</h2>
      <p>This browser-only comparison displays candidate status only. It does not calculate a winner, compare live prices, or send your selections to a server.</p>
      <form id="compare-form" data-catalog={JSON.stringify(publicCatalog.products)}>
        <div class="compare-controls">
          <label for="compare-search">Search tools
            <input id="compare-search" name="search" type="search" autocomplete="off" />
          </label>
          <label for="compare-category">Category
            <select id="compare-category" name="category">
              {categories.map(category => <option value={category}>{category}</option>)}
            </select>
          </label>
          <label for="compare-workflow">Workflow
            <select id="compare-workflow" name="workflow"><option value="">All workflows</option></select>
          </label>
          <label for="compare-first">First tool
            <select id="compare-first" name="first" required></select>
          </label>
          <label for="compare-second">Second tool
            <select id="compare-second" name="second" required></select>
          </label>
          <label for="compare-third">Optional third tool
            <select id="compare-third" name="third"><option value="">No third tool</option></select>
          </label>
        </div>
        <button type="submit">Compare selected tools</button>
        <p id="comparison-error" role="alert"></p>
      </form>
      <noscript><p>Enable JavaScript to use the interactive comparison, or review the category tables below.</p></noscript>
      <div id="comparison-result" aria-live="polite" aria-atomic="true"></div>
      <p class="helper">After comparing two candidates, download neutral questions to ask each vendor. Answers start unverified; evidence stays on your device.</p>
      <button id="download-comparison-csv" type="button" disabled>Download vendor questions (CSV)</button>
      <p id="comparison-download-status" role="status" aria-live="polite"></p>
      <p class="helper">“Vendor sources identified” measures links collected for research, not verified claims or product quality.</p>
    </section>
    {categories.map((category) => (
      <section aria-label={`${category} candidates`}>
        <h2>{category}</h2>
        <div class="table-scroll" role="region" aria-label={`${category} comparison table, scroll horizontally for all columns`} tabindex="0">
          <table>
            <caption>{category}: preliminary research candidates</caption>
            <thead><tr><th scope="col">Software</th><th scope="col">Product overview</th><th scope="col">Team fit</th><th scope="col">Pricing</th><th scope="col">Research status</th></tr></thead>
            <tbody>
              {categoryComparisonRows(products, category).map(p => (
                <tr>
                  <th scope="row"><a href={`/software/${p.id}/`}>{p.name}</a></th>
                  <td>{p.description}</td>
                  <td>{p.teamFit}</td>
                  <td>{p.pricing}</td>
                  <td>{p.editorialStatus}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
    <p>Product pages include links to official documentation for independent follow-up. A deeper feature-by-feature comparison will require approved claim-level evidence.</p>
  </main>
  <footer>StackPilot AI · <a href="/privacy/">Privacy notes</a> · <a href="/methodology/">Methodology</a> · <a href="/disclosure/">Affiliate disclosure</a></footer>
<script type="module" src="/scripts/compare-picker.js"></script>
</body>
</html>
