---
import products from '../../data/products.json';
import evidenceLedger from '../../data/comparison-evidence.json';
import {validateComparisonEvidence} from '../../lib/comparison-evidence.mjs';
import { getAllComparisonPairs, getComparisonPair } from '../../lib/comparison-pairs.mjs';
import { buildFAQSchema, buildBreadcrumbSchema, serializeJsonLd } from '../../lib/structured-data.mjs';
import { canonicalUrl } from '../../lib/site-origin.mjs';
import { getVerifiedVendorFacts } from '../../lib/verified-vendor-facts.mjs';

export function getStaticPaths() {
  return getAllComparisonPairs().map(pair => ({
    params: { slug: pair.slug }
  }));
}

// Build fails closed if a comparison claim lacks an unapproved evidence record.
validateComparisonEvidence(evidenceLedger, getAllComparisonPairs(), products);
const pairData = getComparisonPair(Astro.params.slug, products);
const { pair, first, second, matrix } = pairData;
const verifiedDocs = getVerifiedVendorFacts(pair.slug);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Compare', url: '/compare/' },
  { name: pair.title, url: `/compare/${pair.slug}/` }
];
const breadcrumbJson = serializeJsonLd(buildBreadcrumbSchema(breadcrumbs));

const faqs = [
  {
    question: `How does StackPilot AI compare ${first.name} and ${second.name}?`,
    answer: `StackPilot AI provides unverified research prompts about architectural model, seat commitments, data mobility, and verification status for ${first.name} and ${second.name}. It does not establish feature parity, buyer suitability, or a preferred vendor.`
  },
  {
    question: `Are the pricing and feature claims for ${pair.title} verified?`,
    answer: `No. All pricing and feature claims remain unverified candidate notes. Buyers should confirm current details directly with official vendors.`
  }
];
const faqJson = serializeJsonLd(buildFAQSchema(faqs));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl(`/compare/${pair.slug}/`)} />
  <meta name="description" content={pair.metaDescription} />
  <title>{pair.title} Comparison | StackPilot AI</title>
  <script type="application/ld+json" set:html={breadcrumbJson}></script>
  <script type="application/ld+json" set:html={faqJson}></script>
  <style>
    :root { font-family: system-ui, sans-serif; background: #0b1220; color: #e9f1ff; }
    * { box-sizing: border-box; }
    body { margin: 0; }
    header, main, footer { max-width: 1080px; margin: auto; padding: 24px; }
    a { color: #7ce8c6; }
    p, li { color: #c6d5e8; line-height: 1.7; }
    section { margin: 38px 0; }
    .table-scroll { overflow-x: auto; border: 1px solid #34455f; border-radius: 12px; }
    table { width: 100%; border-collapse: collapse; background: #152138; min-width: 640px; }
    th, td { text-align: left; padding: 16px; border-bottom: 1px solid #34455f; vertical-align: top; }
    thead th { background: #253652; color: #fff; }
    .notice { background: #152138; border-left: 4px solid #edc777; padding: 16px; border-radius: 0 8px 8px 0; }
    .links { display: flex; flex-wrap: wrap; gap: 18px; }
    .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .card { background: #152138; border: 1px solid #34455f; border-radius: 12px; padding: 20px; }
    .card h3 { margin-top: 0; color: #fff; }
    #download-questions { background: #7ce8c6; color: #06231d; border: 0; border-radius: 8px; padding: 12px 20px; font-weight: 700; cursor: pointer; }
    :focus-visible { outline: 3px solid #7ce8c6; outline-offset: 3px; }
    @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }
    .skip-link { position: absolute; top: -100px; left: 16px; background: #7ce8c6; color: #06231d; padding: 10px 16px; font-weight: 700; border-radius: 6px; z-index: 1000; text-decoration: none; }
    .skip-link:focus { top: 16px; outline: 3px solid #fff; }
  </style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <header class="links">
    <nav aria-label="Site navigation">
      <a href="/">← StackPilot AI</a>
      <a href="/compare/">All comparisons</a>
      <a href={`/software/${first.id}/`}>{first.name} profile</a>
      <a href={`/software/${second.id}/`}>{second.name} profile</a>
      <a href="/methodology/">Methodology</a>
      <a href="/disclosure/">Disclosure</a>
    </nav>
  </header>
  <main id="main">
    <p>Unverified buyer research worksheet</p>
    <h1>{pair.title}</h1>
    <p class="notice">
      <strong>Research-only boundary:</strong> This is not a verified feature comparison. The matrix contains unverified prompts rather than authenticated vendor specifications. It does not establish a better vendor, fit, or savings. No affiliate links or commercial rankings are active. Confirm all material details directly with each vendor before signing contracts.
    </p>

    <section aria-labelledby="verified-docs">
      <h2 id="verified-docs">First-party vendor documentation snapshot (checked {verifiedDocs.checkedAt})</h2>
      <p>Owner-reviewed excerpts from official vendor documentation. Vendor pricing, quotas, and plan terms change periodically; confirm current details directly via the linked official documentation below.</p>
      <div class="table-scroll" role="region" tabindex="0" aria-label={`First-party vendor documentation snapshot for ${pair.title}, scroll horizontally for all columns`}>
        <table>
          <thead>
            <tr>
              <th scope="col" style="width: 22%;">Dimension</th>
              <th scope="col" style="width: 39%;">{first.name}</th>
              <th scope="col" style="width: 39%;">{second.name}</th>
            </tr>
          </thead>
          <tbody>
            {verifiedDocs.rows.map((row) => (
              <tr>
                <th scope="row"><strong>{row.dimension}</strong></th>
                <td>
                  <p style="margin-top: 0;">{row.first.summary}</p>
                  <a href={row.first.sourceUrl} target="_blank" rel="noopener noreferrer">{row.first.sourceLabel} ↗</a>
                </td>
                <td>
                  <p style="margin-top: 0;">{row.second.summary}</p>
                  <a href={row.second.sourceUrl} target="_blank" rel="noopener noreferrer">{row.second.sourceLabel} ↗</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="side-by-side">
      <h2 id="side-by-side">Questions to verify with each vendor</h2>
      <div class="table-scroll" role="region" tabindex="0" aria-label="Unverified vendor research questions, scroll horizontally for all columns">
        <table>
          <thead>
            <tr>
              <th scope="col" style="width: 25%;">Evaluation Dimension</th>
              <th scope="col" style="width: 35%;">{first.name}</th>
              <th scope="col" style="width: 35%;">{second.name}</th>
            </tr>
          </thead>
          <tbody>
            {matrix.map((row) => (
              <tr>
                <th scope="row">
                  <strong>{row.dimension}</strong>
                  <br />
                  <small style="color: #9ab0cf;">{row.buyerContext}</small>
                  <small style="display: block; color: #edc777;">Evidence: {row.evidenceStatus} · Claim ID: {row.claimId} · No editorial approval</small>
                </th>
                <td>{row.firstValue}</td>
                <td>{row.secondValue}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="profiles">
      <h2 id="profiles">Candidate software profiles</h2>
      <div class="grid">
        <article class="card">
          <h3>{first.name}</h3>
          <p>{first.description}</p>
          <p><strong>Category:</strong> {first.category}</p>
          <p><a href={`/software/${first.id}/`}>Explore full {first.name} profile →</a></p>
        </article>
        <article class="card">
          <h3>{second.name}</h3>
          <p>{second.description}</p>
          <p><strong>Category:</strong> {second.category}</p>
          <p><a href={`/software/${second.id}/`}>Explore full {second.name} profile →</a></p>
        </article>
      </div>
    </section>

    <section aria-labelledby="tools-section">
      <h2 id="tools-section">Related decision tools & calculators</h2>
      <p>Use these client-side tools to model seat counts, migration readiness, and cost scenarios before speaking with sales reps:</p>
      <ul>
        {pair.relatedTools.map(tool => (
          <li><a href={tool.href}>{tool.title}</a> — Run interactive client-side scenarios.</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="guides-section">
      <h2 id="guides-section">Related buyer guides</h2>
      <ul>
        {pair.relatedGuides.map(guide => (
          <li><a href={guide.href}>{guide.title}</a> — Neutral operational walkthrough.</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="questions">
      <h2 id="questions">Vendor due diligence questions</h2>
      <p>Download structured questions to ask sales representatives from both {first.name} and {second.name}. Formatted for offline spreadsheets with formula neutralization:</p>
      <a id="download-questions" href={`/compare/${pair.slug}-vendor-questions.csv`} download>Download vendor questions (CSV)</a>
    </section>
  </main>
  <footer>
    <p>© {new Date().getFullYear()} StackPilot AI. Independent software research. · <a href="/disclosure/">Disclosure</a> · <a href="/privacy/">Privacy</a> · <a href="/methodology/">Methodology</a></p>
  </footer>
</body>
</html>
