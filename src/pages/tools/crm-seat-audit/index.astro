---
import { canonicalUrl } from '../../../lib/site-origin.mjs';
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="robots" content="index, follow"/><link rel="canonical" href={canonicalUrl('/tools/crm-seat-audit/')} />
 <meta name="description" content="Private buyer-entered CRM seat utilization and renewal audit."/>
 <title>CRM paid-seat audit | StackPilot AI</title>
 <link rel="stylesheet" href="/styles/executive-theme.css" />
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header><nav aria-label="Primary navigation">
 <a href="/">← StackPilot AI</a>
 <a href="/tools/software-cost-calculator/">Cost calculator</a>
 <a href="/tools/requirements-checklist/">Requirements checklist</a>
 <a href="/methodology/">Methodology</a>
</nav></header>
<main id="main">
 <p>Private browser-only worksheet</p>
 <h1>CRM paid-seat audit</h1>
 <p>Compare billed seat capacity with paid-seat occupancy using counts from your own invoice and admin panel. <strong>Vacant seats do not automatically mean refunds or savings.</strong> Free or view-only users may not occupy a billed seat, depending on the plan.</p>
 <p>No vendor prices, rankings, affiliate links, account signups or form submissions. Enter counts only—not names, invoices or account identifiers. Your inputs are calculated in this tab and are not submitted to StackPilot.</p>
 <form id="seat-form" novalidate>
  <section class="panel" aria-label="Buyer-entered seat counts">
   <div class="grid">
    <label for="seat-billedSeats">Paid seats on the current invoice<input type="text" id="seat-billedSeats" name="billedSeats" inputmode="numeric" autocomplete="off" value="0" required/></label>
    <label for="seat-occupiedPaidSeats">Occupied paid seats in the admin panel<input type="text" id="seat-occupiedPaidSeats" name="occupiedPaidSeats" inputmode="numeric" autocomplete="off" value="0" required/></label>
    <label for="seat-activeUsers">Active users (including free or view-only users)<input type="text" id="seat-activeUsers" name="activeUsers" inputmode="numeric" autocomplete="off" value="0" required/></label>
    <label for="seat-invitedUsers">Invited users (context only)<input type="text" id="seat-invitedUsers" name="invitedUsers" inputmode="numeric" autocomplete="off" value="0" required/></label>
    <label for="seat-deactivatedUsers">Deactivated users (context only)<input type="text" id="seat-deactivatedUsers" name="deactivatedUsers" inputmode="numeric" autocomplete="off" value="0" required/></label>
   </div>
  </section>
  <fieldset class="panel">
   <legend>Provider/account-specific checks</legend>
   <label class="check" for="seat-accountModelConfirmed"><input type="checkbox" id="seat-accountModelConfirmed" name="accountModelConfirmed"/><span>I checked my exact plan and account billing model</span></label>
   <label class="check" for="seat-roleRequirementsConfirmed"><input type="checkbox" id="seat-roleRequirementsConfirmed" name="roleRequirementsConfirmed"/><span>I checked the required editing, viewing and admin roles</span></label>
   <label class="check" for="seat-billingChangeDateConfirmed"><input type="checkbox" id="seat-billingChangeDateConfirmed" name="billingChangeDateConfirmed"/><span>I checked when seat reductions would affect my bill</span></label>
  </fieldset>
  <div class="actions"><button type="submit" id="seat-submit" disabled>Audit my entered seats</button><button type="reset" class="secondary">Clear worksheet</button></div>
 </form>
 <p id="seat-status" role="status" aria-live="polite"></p>
 <section class="panel" aria-labelledby="seat-report-title">
  <h2 id="seat-report-title">Private seat-audit report</h2>
  <label for="seat-report">Copyable report with unresolved checks shown</label>
  <textarea id="seat-report" readonly placeholder="Enter your counts and generate an audit."></textarea>
  <div class="actions"><button type="button" id="seat-copy" class="secondary" disabled>Copy report</button></div>
 </section>
 <p><strong>Important:</strong> User deactivation is not proof that a paid seat was removed from a contract. Billing adjustments depend on plan, renewal date, permissions and commitments. Even a completed worksheet is ready only for human review, not an approved saving estimate. Verify directly with your provider.</p>
</main>
<footer><a href="/privacy/">Privacy notes</a> · <a href="/disclosure/">Affiliate disclosure</a> · © StackPilot AI (working name)</footer>
<script>
 import {auditCrmSeats,formatSeatAuditReport} from '../../../lib/crm-seat-audit.mjs';
 const form=document.querySelector('#seat-form');
 const report=document.querySelector('#seat-report');
 const status=document.querySelector('#seat-status');
 const copy=document.querySelector('#seat-copy');
 const submit=document.querySelector('#seat-submit');
 const counts=['billedSeats','occupiedPaidSeats','activeUsers','invitedUsers','deactivatedUsers'];
 const checks=['accountModelConfirmed','roleRequirementsConfirmed','billingChangeDateConfirmed'];
 function invalidate(){report.value='';copy.disabled=true;}
 form.addEventListener('input',()=>{invalidate();status.textContent='Inputs changed. Generate a new report.';});
 form.addEventListener('change',()=>{invalidate();status.textContent='Checks changed. Generate a new report.';});
 form.addEventListener('submit',event=>{
  event.preventDefault();
  try{
   const input=Object.fromEntries([
    ...counts.map(key=>[key,form.elements.namedItem(key).value]),
    ...checks.map(key=>[key,form.elements.namedItem(key).checked])
   ]);
   const result=auditCrmSeats(input);
   report.value=formatSeatAuditReport(result);
   copy.disabled=false;
   status.textContent=result.status==='INCOMPLETE'
     ?'Audit generated locally; account checks are incomplete.'
     :'Audit generated locally; ready for human review, not a verified billing conclusion.';
  }catch(error){
   invalidate();status.textContent=error instanceof Error?error.message:'Check seat counts.';
  }
 });
 form.addEventListener('reset',()=>{invalidate();status.textContent='Worksheet cleared.';});
 copy.addEventListener('click',async()=>{
  if(!report.value)return;
  try{await navigator.clipboard.writeText(report.value);status.textContent='Report copied.';}
  catch{report.focus();report.select();status.textContent='Clipboard unavailable. Select and copy manually.';}
 });
 submit.disabled=false;
</script>
</body>
</html>