---
import {CRM_MIGRATION_GATES} from '../../../lib/crm-migration-readiness.mjs';
const numericInputs=[
 {id:'sourceRecordCount',label:'Source sample record count',hint:'Aggregate count from an authorized source test export (1–10,000,000).'},
 {id:'targetRecordCount',label:'Target sample record count',hint:'Aggregate count from the corresponding approved test import (1–10,000,000).'},
 {id:'cutoverWindowMinutes',label:'Proposed cutover window (minutes)',hint:'The duration reserved for the controlled migration plan (1–1,440).'},
 {id:'measuredRollbackMinutes',label:'Measured rollback rehearsal (minutes)',hint:'Measured duration from an authorized rollback rehearsal, not a guess (1–1,440).'}
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="index, follow">
<meta name="description" content="Private browser-only CRM migration readiness worksheet using aggregate record reconciliation and rollback gates.">
<title>CRM migration readiness worksheet | StackPilot AI</title>
<style>
:root{font-family:system-ui,sans-serif;background:#0b1220;color:#edf5ff;color-scheme:dark}
*{box-sizing:border-box}body{margin:0}
header,main,footer{max-width:990px;margin:auto;padding:24px}
nav{display:flex;gap:16px;flex-wrap:wrap}
a{color:#7ce8c6}h1{font-size:clamp(31px,5vw,54px)}
p,li{line-height:1.6;color:#c8d9ed}
.panel{min-width:0;background:#152138;border:1px solid #405675;border-radius:16px;padding:23px;margin:20px 0}
.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
label{display:block;font-weight:650;line-height:1.4;margin:9px 0}
input,select,textarea{width:100%;background:#0b1220;color:#edf5ff;border:1px solid #8ca4c1;border-radius:8px;padding:12px;font:inherit}
textarea{resize:vertical;min-height:350px;overflow-wrap:anywhere}
fieldset{margin:0;border:0;padding:0}legend{font-weight:750;font-size:1.2rem;margin-bottom:14px}
.gate{padding:14px 0;border-bottom:1px solid #405675}
.gate:last-child{border-bottom:0}.gate select{max-width:500px}
button{border:0;border-radius:8px;background:#7ce8c6;color:#06231d;padding:12px 18px;font-weight:750;cursor:pointer}
button.secondary{background:#293d58;color:#edf5ff;border:1px solid #91abc9}
button:disabled{opacity:.5;cursor:not-allowed}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:16px}
:focus-visible{outline:3px solid #7ce8c6;outline-offset:3px}
#crm-status{color:#ffe2a6;min-height:1.5em}
footer{border-top:1px solid #405675;margin-top:20px}
@media(max-width:650px){header,main,footer{padding:16px}.panel{padding:16px}.fields{grid-template-columns:1fr}}
.skip-link{position:absolute;top:-100px;left:16px;background:#7ce8c6;color:#06231d;padding:10px 16px;font-weight:700;border-radius:6px;z-index:1000;text-decoration:none}.skip-link:focus{top:16px;outline:3px solid #fff}
</style>
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header><nav aria-label="Site navigation">
<a href="/">← StackPilot AI</a><a href="/guides/crm-migration-checklist/">CRM migration guide</a><a href="/tools/requirements-checklist/">Requirements checklist</a><a href="/methodology/">Methodology</a>
</nav></header>
<main id="main">
<p>Private browser-only migration planning</p>
<h1>CRM migration readiness worksheet</h1>
<p>Use <strong>aggregate test record counts</strong>, a proposed cutover window and measured rollback time to reveal planning blockers before a CRM migration review. Matching counts alone cannot verify record integrity, permissions or associations. A passing result is <strong>not authorization</strong> to migrate or change any live system.</p>
<p><strong>Privacy:</strong> Enter aggregate numbers only. Do not enter client records, company secrets, contact identifiers, credentials or sensitive business data. Use authorized test results, not production exports from an unapproved environment.</p>
<form id="crm-form" novalidate>
<section class="panel" aria-labelledby="crm-aggregate-title">
<h2 id="crm-aggregate-title">1. Test reconciliation and rollback timing</h2>
<div class="fields">
{numericInputs.map(field=><div>
<label for={'crm-'+field.id}>{field.label}</label>
<input id={'crm-'+field.id} name={field.id} type="text" inputmode="numeric" pattern="[1-9][0-9]*" autocomplete="off" required placeholder="Required; no assumed default">
<p>{field.hint}</p>
</div>)}
</div>
</section>
<fieldset class="panel">
<legend>2. Five self-reported evidence checks</legend>
{CRM_MIGRATION_GATES.map(g=><div class="gate">
<label for={'crm-'+g.id}>{g.label}</label>
<p>{g.hint}</p>
<select id={'crm-'+g.id} name={g.id}>
<option value="not-assessed">Not assessed — default</option>
<option value="pass">Pass — self-reported only</option>
<option value="fail">Fail — unresolved</option>
</select>
</div>)}
</fieldset>
<div class="actions">
<button type="submit">Assess CRM readiness</button>
<button type="reset" class="secondary">Clear assessment</button>
</div>
</form>
<p id="crm-status" role="status" aria-live="polite"></p>
<section class="panel" aria-labelledby="crm-report-heading">
<h2 id="crm-report-heading">Planning report (not a migration approval)</h2>
<label for="crm-report">Review your assessment before sharing it with your authorized team</label>
<textarea id="crm-report" readonly placeholder="Enter aggregate test counts and evidence status, then assess."></textarea>
<div class="actions">
<button type="button" id="crm-copy" class="secondary" disabled>Copy report</button>
<button type="button" id="crm-download" class="secondary" disabled>Download offline CSV</button>
</div>
<p>The CSV contains only aggregate counts and fixed status tokens. These are <strong>self-reported</strong>, not independently verified by StackPilot. Any GO/NO-GO operational decision must be made by your designated human reviewer, supported by independently examined evidence and an approved migration runbook.</p>
</section>
<section class="panel">
<h2>When is the answer NO_GO?</h2>
<ul>
<li>Source and imported target test counts differ — investigate missing or duplicate test records.</li>
<li>A rehearsed rollback takes longer than the proposed change window.</li>
<li>Any export-permission, field-mapping, associations, integration or backup test is failed or not assessed.</li>
</ul>
<p>If everything is self-reported as passing, the result is only READY_FOR_HUMAN_REVIEW. No real migration, backup, restore, record export, vendor query, payment or account action occurs here.</p>
</section>
<p>All calculations are local to this browser tab; form values are not transmitted to StackPilot. Netlify Web Analytics is documented as enabled at the hosting layer and may record page visits, but this browser-only tool does not send your worksheet values to it. See <a href="/privacy/">privacy notes</a>.</p>
</main>
<footer><a href="/privacy/">Privacy</a> · <a href="/disclosure/">Disclosures</a> · StackPilot AI (working name)</footer>
<script>
import {CRM_MIGRATION_GATES,assessCrmMigrationReadiness,formatCrmMigrationReadinessReport,formatCrmMigrationReadinessCsv} from '../../../lib/crm-migration-readiness.mjs';
const fields=['sourceRecordCount','targetRecordCount','cutoverWindowMinutes','measuredRollbackMinutes',...CRM_MIGRATION_GATES.map(g=>g.id)];
const form=document.querySelector('#crm-form');
const status=document.querySelector('#crm-status');
const output=document.querySelector('#crm-report');
const copy=document.querySelector('#crm-copy');
const download=document.querySelector('#crm-download');
let current=null;
function invalidate(){
 current=null;output.value='';copy.disabled=true;download.disabled=true;
}
form.addEventListener('input',()=>{
 invalidate();status.textContent='Inputs changed. Reassess before exporting.';
});
form.addEventListener('change',()=>{
 invalidate();status.textContent='Inputs changed. Reassess before exporting.';
});
form.addEventListener('submit',event=>{
 event.preventDefault();
 try{
  const input=Object.fromEntries(fields.map(k=>[k,form.elements.namedItem(k).value]));
  const result=assessCrmMigrationReadiness(input);
  output.value=formatCrmMigrationReadinessReport(result);
  current=result;copy.disabled=false;download.disabled=false;
  status.textContent=result.status==='NO_GO'
   ?'NO_GO — mismatch, rollback window or evidence checks need review.'
   :'READY_FOR_HUMAN_REVIEW — this is not authorization for a CRM migration.';
 }catch(error){
  invalidate();status.textContent=error instanceof Error?error.message:'Invalid worksheet fields.';
 }
});
form.addEventListener('reset',()=>{
 invalidate();status.textContent='Assessment cleared; no data was submitted.';
});
copy.addEventListener('click',async()=>{
 if(!current||!output.value||copy.disabled)return;
 try{await navigator.clipboard.writeText(output.value);status.textContent='Report copied locally.';}
 catch{output.focus();output.select();status.textContent='Clipboard unavailable. Select and copy the report manually.';}
});
download.addEventListener('click',()=>{
 if(!current||!output.value||download.disabled)return;
 try{
  const csv=formatCrmMigrationReadinessCsv(current);
  const file=new Blob([csv],{type:'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(file);
  const anchor=document.createElement('a');
  anchor.href=url;anchor.download='stackpilot-crm-migration-readiness.csv';
  document.body.append(anchor);anchor.click();anchor.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
  status.textContent='Offline CSV saved locally; no worksheet data was submitted.';
 }catch{
  invalidate();status.textContent='CSV export unavailable; reassess the worksheet.';
 }
});
</script>
</body></html>
