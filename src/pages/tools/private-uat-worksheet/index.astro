---
import {OWNER_UAT_CHECKS} from '../../../lib/owner-uat-worksheet.mjs';
import {buildPreviewBuildIdentity} from '../../../lib/preview-build-identity.mjs';
// Only whitelisted Netlify BUILD metadata; no runtime authentication secrets.
const previewIdentity=buildPreviewBuildIdentity({
 NETLIFY:process.env.NETLIFY,
 CONTEXT:process.env.CONTEXT,
 PULL_REQUEST:process.env.PULL_REQUEST,
 REVIEW_ID:process.env.REVIEW_ID,
 COMMIT_REF:process.env.COMMIT_REF
});
const previewPrKnown=previewIdentity.status==='PREVIEW_COMMIT_REPORTED';
const previewPr=previewPrKnown?previewIdentity.prNumber:null;
const githubPrHref=previewPrKnown
 ? `https://github.com/hithisisakii09/stackpilot-ai/pull/${previewPr}`
 : 'https://github.com/hithisisakii09/stackpilot-ai/pulls';
const githubPrLabel=previewPrKnown
 ? `the current draft GitHub PR #${previewPr}`
 : 'the GitHub pull-request list (preview identity unavailable)';
const expectedPrShaLabel=previewPrKnown
 ? `Expected PR #${previewPr} HEAD SHA (40 lowercase hex characters)`
 : 'Expected current draft PR HEAD SHA (40 lowercase hex characters)';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="Private browser-only owner review checklist for Netlify preview SHA, live privacy, security and billing observations.">
<title>Private owner UAT evidence worksheet | StackPilot AI</title>
<link rel="stylesheet" href="/styles/executive-theme.css" />
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header><nav aria-label="Site navigation">
<a href="/">← StackPilot AI</a><a href="/preview-build/">Preview build identity</a><a href="/privacy/">Privacy</a><a href="/methodology/">Methodology</a>
</nav></header>
<main id="main">
<p>Private browser-only owner review · ₹0 budget</p>
<h1>Private owner UAT evidence worksheet</h1>
<p>This worksheet records <strong>your self-reported checks</strong> after you personally open StackPilot's protected Netlify Deploy Preview. It <strong>does not test the hosted site for you</strong>, authenticate anyone, validate access restrictions, change provider settings or grant publication permission.</p>
<p><strong>Privacy:</strong> Enter only public-style 40-character Git commit hashes and fixed status choices. Do not enter passwords, cookies, account numbers, identifying personal information, customer data or payment details. The form never transmits selections. Netlify Web Analytics is documented as enabled for page visits; it is separate from this browser-only form.</p>
<p id="owner-uat-pr-context" role="note">{previewPrKnown
 ? `Netlify build metadata identifies preview PR #${previewPr}. This is a build-time hint, not independently verified hosted access or review authority.`
 : 'BLOCKED — preview PR identity unavailable in this build context. Inspect the actual authenticated Netlify Deploy Preview before reporting an identity match.'}</p>
<p>Before using this worksheet, open <a href="/preview-build/">the authenticated build identity page</a> and <a id="owner-uat-github-pr" href={githubPrHref} rel="noopener noreferrer" target="_blank">{githubPrLabel}</a> in separate authorized browser tabs. Compare the full 40-character SHA, not just the prefix, and confirm the preview PR number matches the actual Netlify deployment. If the PR identity is unavailable, either page is inaccessible, or the build reports UNKNOWN, record that as an outstanding blocker rather than assuming it passed.</p>
<form id="owner-uat-form" novalidate>
<section class="panel" aria-labelledby="uat-hash-heading">
<h2 id="uat-hash-heading">1. Compare source commits manually</h2>
<div class="inputs">
<div>
<label for="owner-uat-expectedSha">{expectedPrShaLabel}</label>
<input type="text" id="owner-uat-expectedSha" name="expectedSha" required maxlength="40" autocomplete="off" spellcheck="false" placeholder="Copy the current PR HEAD SHA">
</div>
<div>
<label for="owner-uat-observedSha">Observed authenticated Netlify build SHA (40 lowercase hex characters)</label>
<input type="text" id="owner-uat-observedSha" name="observedSha" required maxlength="40" autocomplete="off" spellcheck="false" placeholder="Enter SHA seen on protected page">
</div>
</div>
<p>The fields are deliberately never prefilled. A matching user-entered string alone cannot prove what Netlify actually served.</p>
</section>
<fieldset class="panel">
<legend>2. Record six independent owner checks</legend>
{OWNER_UAT_CHECKS.map(check=><div class="field">
<label for={'owner-uat-'+check.id}>{check.label}</label>
<p>{check.hint}</p>
<select id={'owner-uat-'+check.id} name={check.id}>
<option value="not-checked">Not checked — default</option>
<option value="pass">Pass — I observed this myself</option>
<option value="fail">Fail — an observed defect</option>
<option value="blocked">Blocked — evidence unavailable</option>
</select>
</div>)}
</fieldset>
<div class="actions">
<button type="submit">Prepare self-reported evidence summary</button>
<button type="reset" class="secondary">Clear worksheet</button>
</div>
</form>
<p id="owner-uat-status" role="status" aria-live="polite"></p>
<section class="panel" aria-labelledby="owner-uat-report-title">
<h2 id="owner-uat-report-title">Offline review summary — not release approval</h2>
<label for="owner-uat-report">Read the evidence summary before sharing it with your authorized reviewer</label>
<textarea readonly id="owner-uat-report" placeholder="No review recorded yet."></textarea>
<div class="actions">
<button type="button" id="owner-uat-copy" class="secondary" disabled>Copy summary</button>
<button type="button" id="owner-uat-download" class="secondary" disabled>Download offline CSV</button>
</div>
<p>Even six self-attested Pass selections and matching hashes produce <strong>OWNER_SELF_REPORTED_ONLY</strong> — never independently verified UAT or approval to merge, publish, index, change access permissions, activate affiliates, accept contracts or spend.</p>
</section>
<section class="panel">
<h2>What else does the owner need?</h2>
<p>The separately generated <a href="https://github.com/hithisisakii09/stackpilot-ai/actions/workflows/agent-ops.yml" rel="noopener noreferrer" target="_blank">private CI UAT packet</a> lists all emitted pages to inspect. Test each route while authenticated; confirm separate anonymous denial and live security headers; inspect Netlify's real Private/Locked, Free plan, analytics and credit usage settings; keep evidence in your authorized local system. All product claims and legal/editorial signoffs remain independently gated.</p>
</section>
</main>
<footer><a href="/disclosure/">Disclosures</a> · <a href="/privacy/">Privacy notes</a> · StackPilot AI private development</footer>
<script>
import {OWNER_UAT_CHECKS,assessOwnerUatEvidence,formatOwnerUatReport,formatOwnerUatCsv} from '../../../lib/owner-uat-worksheet.mjs';
const fields=['expectedSha','observedSha',...OWNER_UAT_CHECKS.map(x=>x.id)];
const form=document.querySelector('#owner-uat-form');
const status=document.querySelector('#owner-uat-status');
const output=document.querySelector('#owner-uat-report');
const copy=document.querySelector('#owner-uat-copy');
const download=document.querySelector('#owner-uat-download');
let current=null;
function invalidate(){
 current=null;output.value='';copy.disabled=true;download.disabled=true;
}
form.addEventListener('input',()=>{
 invalidate();status.textContent='Inputs changed. Reassess before exporting.';
});
form.addEventListener('change',()=>{
 invalidate();status.textContent='Inputs changed. Reassess before exporting.';
});
form.addEventListener('submit',event=>{
 event.preventDefault();
 try{
  const input=Object.fromEntries(fields.map(k=>[k,form.elements.namedItem(k).value]));
  const result=assessOwnerUatEvidence(input);
  output.value=formatOwnerUatReport(result);
  current=result;copy.disabled=false;download.disabled=false;
  status.textContent=result.status==='BLOCKED_UNVERIFIED'
   ?'BLOCKED_UNVERIFIED — source SHA mismatch or one or more owner checks remain incomplete.'
   :'OWNER_SELF_REPORTED_ONLY — NOT independently verified or approved for public release.';
 }catch(error){
  invalidate();status.textContent=error instanceof Error?error.message:'Invalid owner UAT fields.';
 }
});
form.addEventListener('reset',()=>{
 invalidate();status.textContent='Worksheet cleared. No information was submitted.';
});
copy.addEventListener('click',async()=>{
 if(!current||!output.value||copy.disabled)return;
 try{await navigator.clipboard.writeText(output.value);status.textContent='Summary copied locally.';}
 catch{output.focus();output.select();status.textContent='Clipboard unavailable. Select and copy manually.';}
});
download.addEventListener('click',()=>{
 if(!current||!output.value||download.disabled)return;
 try{
  const csv=formatOwnerUatCsv(current);
  const file=new Blob([csv],{type:'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(file);
  const anchor=document.createElement('a');
  anchor.href=url;
  anchor.download='stackpilot-owner-uat-evidence.csv';
  document.body.append(anchor);anchor.click();anchor.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
  status.textContent='Offline self-reported CSV saved. No data was submitted.';
 }catch{
  invalidate();status.textContent='CSV export unavailable. Reassess the worksheet.';
 }
});
</script>
</body>
</html>
