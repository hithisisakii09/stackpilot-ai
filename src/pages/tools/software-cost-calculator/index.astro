---
const fields = [
 ['flatMonthly','Monthly base subscription'],
 ['seatMonthly','Monthly price per seat'],
 ['seats','Number of seats'],
 ['extrasMonthly','Other monthly charges'],
 ['oneTimeFee','One-time setup or migration cost']
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="Compare software subscription costs using only the prices you enter, privately in your browser." />
  <title>Software subscription cost calculator | StackPilot AI</title>
  <style>
    :root{font-family:system-ui,sans-serif;background:#0b1220;color:#edf5ff;color-scheme:dark}
    *{box-sizing:border-box}
    body{margin:0}
    header,main,footer{max-width:1050px;margin:auto;padding:24px}
    nav{display:flex;gap:16px;flex-wrap:wrap}
    a{color:#7ce8c6}
    h1{font-size:clamp(32px,5vw,58px);line-height:1.13}
    p{color:#c8d9ed;line-height:1.65}
    .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
    .panel{background:#152138;border:1px solid #3d5776;padding:22px;border-radius:16px;min-width:0}
    fieldset{margin:0;border:0;padding:0;min-width:0}
    legend{font-size:1.2rem;font-weight:700;margin:0 0 15px}
    label{display:block;margin:13px 0;font-weight:600;line-height:1.45}
    input,select,textarea{display:block;width:100%;margin-top:7px;background:#0b1220;border:1px solid #91a5c0;border-radius:8px;color:#fff;padding:11px;font:inherit;min-width:0}
    textarea{min-height:240px;resize:vertical}
    .settings{display:flex;flex-wrap:wrap;gap:18px}
    .settings label{flex:1;min-width:160px}
    .buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}
    button{background:#7ce8c6;color:#06231d;border:0;border-radius:9px;padding:13px 18px;font-weight:750;cursor:pointer}
    button.secondary{background:#293d58;color:#edf5ff;border:1px solid #7f95b2}
    button:disabled{opacity:.5;cursor:not-allowed}
    :focus-visible{outline:3px solid #7ce8c6;outline-offset:3px}
    #cost-status{min-height:1.5em;color:#ffe2a6}
    footer{border-top:1px solid #374c67;margin-top:30px}
    @media(max-width:720px){.grid{grid-template-columns:1fr}header,main,footer{padding:18px}.panel{padding:16px}}
  </style>
</head>
<body>
  <header><nav aria-label="Primary navigation">
    <a href="/">← StackPilot AI</a>
    <a href="/tools/requirements-checklist/">Requirements checklist</a>
    <a href="/tools/crm-seat-audit/">CRM seat audit</a>
    <a href="/compare/">Compare categories</a>
    <a href="/guides/saas-total-cost-of-ownership/">Cost guide</a>
    <a href="/methodology/">Methodology</a>
  </nav></header>
  <main>
    <p>Private buyer decision tool</p>
    <h1>Software subscription cost calculator</h1>
    <p>Enter estimates from two software quotes to calculate what you might pay over the same period. <strong>We do not supply or verify the prices.</strong> Both options use one currency, and there is no exchange-rate conversion.</p>
    <p>No product endorsements, affiliate links, signups, account data, cookies, or tracking. All calculations happen locally in your browser.</p>
    <form id="calculator-form" novalidate>
      <section class="panel settings" aria-label="Comparison settings">
        <label for="cost-currency">Currency
          <select id="cost-currency" name="currency">
            <option value="INR">INR — Indian rupees</option>
            <option value="USD">USD — US dollars</option>
            <option value="EUR">EUR — Euros</option>
            <option value="GBP">GBP — British pounds</option>
          </select>
        </label>
        <label for="cost-months">Time horizon
          <select id="cost-months" name="months">
            <option value="1">1 month</option>
            <option value="6">6 months</option>
            <option value="12" selected>12 months</option>
            <option value="24">24 months</option>
            <option value="36">36 months</option>
            <option value="60">60 months</option>
          </select>
        </label>
      </section>
      <div class="grid" style="margin-top:18px">
        {['A','B'].map(option => <section class="panel" aria-labelledby={`cost-heading-${option}`}>
          <fieldset data-option={option}>
            <legend id={`cost-heading-${option}`}>Option {option} — your estimate</legend>
            {fields.map(([key,name])=><label for={`cost-${option.toLowerCase()}-${key}`}>{name}
              <input id={`cost-${option.toLowerCase()}-${key}`} name={key} type="text"
                inputmode={key==='seats'?'numeric':'decimal'} autocomplete="off"
                value={key==='seats'?'1':'0'} required />
            </label>)}
          </fieldset>
        </section>)}
      </div>
      <div class="buttons">
        <button type="submit" id="cost-calculate">Compare entered costs</button>
        <button type="reset" id="cost-reset" class="secondary">Reset estimates</button>
      </div>
    </form>
    <p id="cost-status" role="status" aria-live="polite"></p>
    <section class="panel" aria-labelledby="cost-report-label">
      <h2 id="cost-report-label">Your cost breakdown</h2>
      <label for="cost-report">Copyable estimate report
        <textarea id="cost-report" readonly placeholder="Enter your own software costs and compare the two options."></textarea>
      </label>
      <button id="cost-copy" type="button" class="secondary" disabled>Copy estimate</button>
    </section>
    <p><strong>Formula:</strong> (base monthly cost + per-seat monthly cost × seats + other monthly costs) × months + one-time costs.</p>
    <p><strong>Estimate exclusions:</strong> Taxes, currency exchange, contract discounts, usage overages and future price increases are not included unless you enter your own allowances under costs. A lower number is not a recommendation: verify actual features, contractual terms and region-specific fees with the vendors.</p>
  </main>
  <footer><a href="/privacy/">Privacy notes</a> · <a href="/disclosure/">Affiliate disclosure</a> · © {new Date().getFullYear()} StackPilot AI (working name)</footer>
  <script>
    import {compareSubscriptionCosts,plainTextCostReport} from '../../../lib/cost-comparison.mjs';
    const form=document.querySelector('#calculator-form');
    const report=document.querySelector('#cost-report');
    const status=document.querySelector('#cost-status');
    const copy=document.querySelector('#cost-copy');
    const read=section=>Object.fromEntries(
      ['flatMonthly','seatMonthly','seats','extrasMonthly','oneTimeFee'].map(key=>
        [key,section.querySelector('input[name="'+key+'"]').value])
    );
    form.addEventListener('submit',event=>{
      event.preventDefault();
      try{
        const input={
          currency:form.elements.currency.value,
          months:Number(form.elements.months.value),
          optionA:read(form.querySelector('fieldset[data-option="A"]')),
          optionB:read(form.querySelector('fieldset[data-option="B"]'))
        };
        const compared=compareSubscriptionCosts(input);
        report.value=plainTextCostReport(compared);
        copy.disabled=false;
        status.textContent='Estimate calculated locally. No data was submitted.';
      }catch(error){
        report.value='';
        copy.disabled=true;
        status.textContent=error instanceof Error?error.message:'Check your entered amounts.';
      }
    });
    form.addEventListener('reset',()=>{
      report.value='';
      copy.disabled=true;
      status.textContent='Estimates reset.';
    });
    copy.addEventListener('click',async()=>{
      if(!report.value)return;
      try{
        await navigator.clipboard.writeText(report.value);
        status.textContent='Estimate copied.';
      }catch{
        report.focus();report.select();
        status.textContent='Clipboard unavailable. Select and copy the report manually.';
      }
    });
  </script>
</body>
</html>
