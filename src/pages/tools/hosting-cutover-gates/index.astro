---
import { canonicalUrl } from '../../../lib/site-origin.mjs';
import { HOSTING_GATE_DEFINITIONS } from '../../../lib/hosting-cutover-assessment.mjs';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="index, follow"/><link rel="canonical" href={canonicalUrl('/tools/hosting-cutover-gates/')} />
<meta name="description" content="Private, vendor-neutral hosting cutover preparation and NO-GO checklist."/>
<title>Hosting cutover gate assessor | StackPilot AI</title>
<link rel="stylesheet" href="/styles/executive-theme.css" />
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header><nav aria-label="Primary navigation">
<a href="/">← StackPilot AI</a><a href="/guides/hosting-migration-checklist/">Hosting migration guide</a><a href="/tools/requirements-checklist/">Requirements checklist</a><a href="/methodology/">Methodology</a>
</nav></header>
<main id="main">
<p>Private browser-only preparation tool</p>
<h1>Hosting cutover gate assessor</h1>
<p>Use five checkpoints to identify missing cutover evidence before asking your authorized owner to review a hosting migration. This tool is <strong>not an authorization</strong> to switch traffic, change DNS, spend money, stop an old server, or move customer data.</p>
<p>Choose only the evidence status you have personally checked. A Pass is <strong>user-entered, not independently verified</strong>. Any Fail or Not assessed gives NO_GO. Five Pass entries produce only READY_FOR_HUMAN_REVIEW, not GO.</p>
<form id="gate-form" novalidate>
<fieldset class="panel">
<legend>Five cutover evidence checkpoints</legend>
{HOSTING_GATE_DEFINITIONS.map(g=>
<div class="gate-row">
<label for={'gate-'+g.id}>{g.label}</label>
<p>{g.hint}</p>
<select id={'gate-'+g.id} name={g.id}>
<option value="not-assessed">Not assessed</option>
<option value="pass">Pass — self-attested</option>
<option value="fail">Fail — unresolved blocker</option>
</select>
</div>
)}
</fieldset>
<div class="actions"><button type="submit">Assess planning gates</button><button type="reset" class="secondary">Clear assessment</button></div>
</form>
<p id="gate-status" role="status" aria-live="polite"></p>
<section class="panel" aria-labelledby="gate-output-title">
<h2 id="gate-output-title">Private human-review preparation report</h2>
<label for="gate-report">Read the report before copying or sharing</label>
<textarea id="gate-report" readonly placeholder="Select evidence statuses and generate an assessment."></textarea>
<div class="actions"><button type="button" id="gate-copy" class="secondary" disabled>Copy report</button><button type="button" id="gate-download" class="secondary" disabled>Download offline CSV</button></div>
<p>CSV entries are self-attested status labels only; the file cannot document approvals, verify backups or authorize a cutover. Keep actual evidence in your own authorized system.</p>
</section>
<section class="panel">
<h2>Who should make the decision?</h2>
<p>Your designated DNS, infrastructure, data/compliance and incident owners must review real evidence and approve a separate controlled migration runbook. This worksheet is useful even when the result is NO_GO. Do not paste passwords, client information, domain account identifiers or customer data here.</p>
</section>
<p><strong>Privacy:</strong> The selections are processed in this tab, and your CSV is created on your device. They are not submitted to StackPilot. Netlify Web Analytics is documented as enabled at the hosting layer and may record page visits; it does not receive these selections from this browser-only tool. See <a href="/privacy/">privacy notes</a>.</p>
</main>
<footer><a href="/privacy/">Privacy notes</a> · <a href="/disclosure/">Affiliate disclosure</a> · StackPilot AI (working name)</footer>
<script>
import {HOSTING_GATE_DEFINITIONS,assessHostingCutover,formatHostingCutoverReport,formatHostingCutoverCsv} from '../../../lib/hosting-cutover-assessment.mjs';
const form=document.querySelector('#gate-form');
const status=document.querySelector('#gate-status');
const output=document.querySelector('#gate-report');
const copy=document.querySelector('#gate-copy');
const download=document.querySelector('#gate-download');
let result=null;
function invalidate(){
 result=null;
 output.value='';
 copy.disabled=true;
 download.disabled=true;
}
form.addEventListener('change',()=>{
 invalidate();
 status.textContent='Selections changed. Reassess before copying or downloading.';
});
form.addEventListener('submit',event=>{
 event.preventDefault();
 try{
  const input=Object.fromEntries(HOSTING_GATE_DEFINITIONS.map(g=>[g.id,form.elements.namedItem(g.id).value]));
  const current=assessHostingCutover(input);
  output.value=formatHostingCutoverReport(current);
  result=current;
  copy.disabled=false;
  download.disabled=false;
  status.textContent=current.status==='NO_GO'
   ? 'NO_GO — one or more cutover evidence gates remain failed or unassessed.'
   : 'READY_FOR_HUMAN_REVIEW — this is not authorization for a hosting cutover.';
 }catch(error){
  invalidate();
  status.textContent=error instanceof Error?error.message:'Invalid assessment.';
 }
});
form.addEventListener('reset',()=>{invalidate();status.textContent='Assessment cleared.';});
copy.addEventListener('click',async()=>{
 if(!result||!output.value)return;
 try{await navigator.clipboard.writeText(output.value);status.textContent='Report copied locally.';}
 catch{output.focus();output.select();status.textContent='Clipboard unavailable. Select and copy text manually.';}
});
download.addEventListener('click',()=>{
 if(!result||!output.value||download.disabled)return;
 try{
  const csv=formatHostingCutoverCsv(result);
  const file=new Blob([csv],{type:'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(file);
  const anchor=document.createElement('a');
  anchor.href=url;
  anchor.download='stackpilot-hosting-cutover-gates.csv';
  document.body.append(anchor);
  anchor.click();
  anchor.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
  status.textContent='Offline CSV saved on your device; no assessment was submitted.';
 }catch{
  invalidate();
  status.textContent='CSV export unavailable; reassess the checkpoints.';
 }
});
</script>
</body></html>
