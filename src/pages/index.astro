---
import { canonicalUrl } from '../lib/site-origin.mjs';
import products from '../data/products.json';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="Category-based research of unverified software candidates for small agencies."><meta name="robots" content="index, follow"><link rel="canonical" href={canonicalUrl('/')} /><meta name="google-site-verification" content="pB9qm1NBbX7Las9rVBe0mFhFd_OqXAL4q-oQ5PUyYWM" /><title>StackPilot AI | Find your software stack</title><link rel="stylesheet" href="/styles/executive-theme.css" />
</head><body><a href="#main" class="skip-link">Skip to main content</a><header><div class="brand">✦ StackPilot <span class="accent">AI</span></div><nav aria-label="Site navigation"><a href="#advisor">Advisor</a><a href="#tools">Tools</a><a href="/compare/">Compare</a><a href="/tools/requirements-checklist/">Free checklist</a><a href="/tools/software-cost-calculator/">Cost calculator</a><a href="/tools/crm-seat-audit/">CRM seat audit</a><a href="/tools/seo-audit-scope/">SEO audit scope planner</a><a href="/guides/saas-total-cost-of-ownership/">SaaS cost guide</a><a href="/guides/crm-migration-checklist/">CRM migration guide</a><a href="/tools/crm-migration-readiness/">CRM migration readiness</a><a href="/guides/hosting-migration-checklist/">Hosting migration guide</a><a href="/tools/hosting-cutover-gates/">Hosting cutover assessor</a><a href="/tools/backup-restore-drill/">Backup restore drill</a><a href="/tools/hosting-hidden-costs/">Hosting hidden-cost worksheet</a><a href="/research/">Research status</a><a href="/methodology/">Methodology</a><a href="/disclosure/">Disclosure</a></nav></header><main id="main"><section class="hero"><p class="accent">Independent software guidance</p><h1>Explore software categories. <span class="accent">Verify before choosing.</span></h1><p>Explore unverified research candidates for small agencies, not personalized recommendations. Category matches are alphabetical, unranked; no paid rankings or sign-up required.</p><a class="button" href="#advisor">Explore category matches →</a><p>Prepare questions for both vendors: <a href="/compare/hubspot-vs-pipedrive/">HubSpot vs Pipedrive</a> · <a href="/compare/semrush-vs-ahrefs/">Semrush vs Ahrefs</a> · <a href="/compare/kinsta-vs-cloudways/">Kinsta vs Cloudways</a></p><p>Want to review unused licenses before renewal? <a href="/tools/crm-seat-audit/">Audit your paid CRM seats</a> using your own counts. Billing impact remains unknown until you confirm your contract.</p></section><section class="section" id="advisor"><h2>Software stack advisor</h2><p>Choose your priority, team size, and budget. These are category-only matches, not personalized recommendations. Team size and budget do not change the results while suitability remains unverified.</p><div class="quiz"><div class="fields"><label>Priority<select id="goal"><option value="sales">Sales & CRM</option><option value="seo">SEO & marketing</option><option value="hosting">Website hosting</option></select></label><label>Team size<select id="team"><option>Solo</option><option>2–20</option><option>21+</option></select></label><label>Budget<select id="budget"><option>Minimal</option><option>Moderate</option><option>Premium</option></select></label></div><button class="button" id="recommend" type="button" disabled>Show category matches</button><div id="result" class="result" role="status" aria-live="polite"></div></div></section><section id="tools" class="section"><h2>Explore software</h2><p>Introductory product descriptions only; current pricing and features are not independently verified.</p><div class="cards">{products.map(p=><article class="card"><h3>{p.name}</h3><p>{p.description}</p><p>Editorial review pending.</p><p><a href={`/software/${p.id}/`}>View profile</a></p><a href={p.website} rel="noopener noreferrer" target="_blank">Official website ↗</a></article>)}</div></section><section id="disclosure" class="section"><h2>Affiliate disclosure</h2><p class="notice">We may eventually earn commissions through approved affiliate links. This MVP currently contains no affiliate tracking links. Product recommendations are not paid placements.</p><p>The recommendation quiz processes selections in your browser; it does not submit personal data.</p></section></main><footer>© {new Date().getFullYear()} StackPilot AI (working name). Independent research. · <a href="/privacy/">Privacy notes</a> · <a href="/preview-build/">Preview build identity</a> · <a href="/tools/private-uat-worksheet/">Owner UAT worksheet</a></footer><script>
import products from '../data/products.json';
import { recommend } from '../lib/recommend.mjs';
import {getPublicComparisonRoute} from '../lib/public-comparison-routes.mjs';

const button = document.querySelector('#recommend');
button?.addEventListener('click', () => {
  const goal = document.querySelector('#goal').value;
  const team = document.querySelector('#team').value;
  const budget = document.querySelector('#budget').value;
  const output = document.querySelector('#result');
  if (!output) return;
  output.replaceChildren();
  const matches = recommend(products, { goal, team, budget });
  const h = document.createElement('h3');
  h.textContent = matches.length ? 'Category matches (alphabetical, unranked)' : 'No category matches yet';
  output.append(h);
  for (const { product, reasons, cautions } of matches) {
    const section = document.createElement('section');
    const title = document.createElement('h4');
    title.textContent = product.name;
    section.append(title);
    const why = document.createElement('p');
    why.textContent = 'Why it appears: ' + reasons.join(' ');
    section.append(why);
    for (const caution of cautions) {
      const note = document.createElement('p');
      note.textContent = 'Important: ' + caution;
      section.append(note);
    }
    const link = document.createElement('a');
    link.href = product.website;
    link.textContent = 'Check details at the official provider';
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    section.append(link);
    // Neutral navigation only: never import unverified vendor research
    // matrices or workflow-fit copy into this browser bundle.
    const profileLink = document.createElement('a');
    profileLink.href = `/software/${product.id}/`;
    profileLink.textContent = 'View product profile';
    section.append(profileLink);
    const peerPath = getPublicComparisonRoute(product.id);
    if (peerPath) {
      const peerLink = document.createElement('a');
      peerLink.href = peerPath;
      peerLink.textContent = 'Review questions for category peer';
      section.append(peerLink);
    }
    output.append(section);
  }
  const note = document.createElement('p');
  note.textContent = 'These are category matches, not suitability rankings or endorsements. Team size and budget are considered only when verified compatibility data exists. No affiliate links are active.';
  output.append(note);
});
if (button) button.disabled = false;
</script></body></html>