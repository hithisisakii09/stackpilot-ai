---
import products from '../../data/products.json';
import leads from '../../data/evidence-leads.json';
import { buildEvidenceReviewQueue } from '../../lib/evidence-ledger.mjs';

const queue = buildEvidenceReviewQueue(leads, products);
const totalLeads = queue.reduce((sum, item) => sum + item.sourceLeadCount, 0);
const needsRefresh = queue.filter(item => item.needsRefresh).length;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content="Prelaunch research workbench for StackPilot AI: source leads and editorial review gaps." />
  <title>Research workbench | StackPilot AI</title>
  <link rel="stylesheet" href="/styles/executive-theme.css" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  <header>
    <nav aria-label="Site navigation">
      <a href="/">← StackPilot AI</a>
      <a href="/compare/">Compare categories</a>
      <a href="/methodology/">Methodology</a>
    </nav>
  </header>
  <main id="main">
    <p>Editorial research · pre-launch</p>
    <h1>Research workbench</h1>
    <p class="notice"><strong>No product claims or pricing have been editorially approved.</strong>
      These records are candidate links awaiting independent review, not verified vendor claims, purchase recommendations or proof of product suitability. Source intake dates are not editorial verification dates.</p>
    <div class="grid">
      <div class="stat"><strong>{queue.length}</strong>Software candidates</div>
      <div class="stat"><strong>{totalLeads}</strong>Source leads (unreviewed)</div>
      <div class="stat"><strong>{needsRefresh}</strong>Source queues needing refresh</div>
    </div>
    {queue.map(item => (
      <section aria-labelledby={`research-${item.productId}`}>
        <h2 id={`research-${item.productId}`}>{item.productName}</h2>
        <p><strong>Category:</strong> {item.category}</p>
        <p class="status">Editorial status: {item.editorialStatus} · Approved claims: {item.approvedClaims}</p>
        <p><strong>Source leads:</strong> {item.sourceLeadCount} · Refresh required: {item.needsRefresh ? 'Yes' : 'Not currently flagged'}</p>
        {item.leads.length ? (
          <ul>{item.leads.map(lead => (
            <li>
              {lead.summary} — logged {lead.recordedOn} · {lead.status}<br />
              <a href={lead.sourceUrl} target="_blank" rel="noopener noreferrer">Open source candidate (external website)</a>
            </li>
          ))}</ul>
        ) : <p>No source leads recorded. Primary-source research is needed.</p>}
        <p><a href={`/software/${item.productId}/`}>View introductory software profile</a></p>
      </section>
    ))}
    <section>
      <h2>Next editorial steps</h2>
      <p>Open each official source, validate its ownership and date, record precise product/plan/region/billing limitations, reconcile conflicts, and obtain authenticated human editorial approval before a claim is shown as verified.</p>
      <p>The current static prototype <strong>cannot grant approval</strong>. There is no staff account system or automatic approval workflow.</p>
    </section>
  </main>
  <footer>StackPilot AI · <a href="/disclosure/">Affiliate disclosure</a> · <a href="/privacy/">Privacy notes</a></footer>
</body>
</html>
