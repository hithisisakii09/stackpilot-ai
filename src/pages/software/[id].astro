---
import products from '../../data/products.json';
import { buildSoftwareApplicationSchema, buildBreadcrumbSchema, serializeJsonLd } from '../../lib/structured-data.mjs';
import { canonicalUrl } from '../../lib/site-origin.mjs';
import { getVerifiedVendorFactsForProduct } from '../../lib/verified-vendor-facts.mjs';
import { getExtendedProducts, validateExtendedCatalog } from '../../lib/extended-catalog.mjs';
import rawExtendedCatalog from '../../data/extended-catalog.json';

export function getStaticPaths() {
  const legacyPaths = products.map((product) => ({
    params: { id: product.id },
    props: { product, isExtended: false, checkedAt: null }
  }));
  const extendedCatalog = validateExtendedCatalog(rawExtendedCatalog, { today: '9999-12-31' });
  const extendedPaths = extendedCatalog.products.map((product) => ({
    params: { id: product.id },
    props: { product, isExtended: true, checkedAt: extendedCatalog.checkedAt }
  }));
  return [...legacyPaths, ...extendedPaths];
}
const { product, isExtended, checkedAt } = Astro.props;
const legacyVerifiedDocs = !isExtended ? getVerifiedVendorFactsForProduct(product.id) : null;
const extendedDocsRows = isExtended ? product.verifiedDocs : [];
const docsCheckedAt = isExtended ? checkedAt : legacyVerifiedDocs.checkedAt;

const categoryLabelMap = { sales: 'CRM', seo: 'SEO', hosting: 'Hosting' };
const displayCategory = isExtended ? (categoryLabelMap[product.category] ?? product.category) : product.category;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Software', url: '/#tools' },
  { name: product.name, url: `/software/${product.id}/` }
];
const softwareSchemaJson = serializeJsonLd(buildSoftwareApplicationSchema({
  id: product.id,
  name: product.name,
  category: displayCategory,
  description: product.description,
  website: product.website
}));
const breadcrumbSchemaJson = serializeJsonLd(buildBreadcrumbSchema(breadcrumbs));

const categoryComparisons = {
  CRM: { label: 'HubSpot vs Pipedrive', href: '/compare/hubspot-vs-pipedrive/' },
  SEO: { label: 'Semrush vs Ahrefs', href: '/compare/semrush-vs-ahrefs/' },
  Hosting: { label: 'Kinsta vs Cloudways', href: '/compare/kinsta-vs-cloudways/' }
};
const comparison = !isExtended ? categoryComparisons[product.category] : null;
const extendedComparisons = isExtended ? product.relatedComparisons : [];

const categoryTools = {
  CRM: [
    { title: 'CRM Paid-Seat Audit', href: '/tools/crm-seat-audit/', desc: 'Audit active vs unused user licenses before renewal.' },
    { title: 'CRM Migration Readiness', href: '/tools/crm-migration-readiness/', desc: 'Assess data hygiene and schema mapping complexity.' }
  ],
  SEO: [
    { title: 'SEO Audit Scope Planner', href: '/tools/seo-audit-scope/', desc: 'Estimate crawl credits and audit duration.' },
    { title: 'Software Cost Calculator', href: '/tools/software-cost-calculator/', desc: 'Calculate multi-year team licensing costs.' }
  ],
  Hosting: [
    { title: 'Hosting Cutover Gate Assessor', href: '/tools/hosting-cutover-gates/', desc: 'Review DNS and SSL cutover readiness gates.' },
    { title: 'Hosting Hidden-Cost Worksheet', href: '/tools/hosting-hidden-costs/', desc: 'Model bandwidth and backup overages.' },
    { title: 'Backup Restore Drill Assessor', href: '/tools/backup-restore-drill/', desc: 'Validate recovery point and time objectives.' }
  ]
};
const tools = categoryTools[displayCategory] || [];

const categoryGuides = {
  CRM: { title: 'CRM Migration Checklist', href: '/guides/crm-migration-checklist/' },
  SEO: { title: 'SaaS Total Cost of Ownership Guide', href: '/guides/saas-total-cost-of-ownership/' },
  Hosting: { title: 'Hosting Migration Checklist', href: '/guides/hosting-migration-checklist/' }
};
const guide = categoryGuides[displayCategory];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={`Introductory profile for ${product.name}. Research and pricing verification pending.`} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl(`/software/${product.id}/`)} />
<title>{product.name} | StackPilot AI software profile</title>
<script type="application/ld+json" set:html={softwareSchemaJson}></script>
<script type="application/ld+json" set:html={breadcrumbSchemaJson}></script>
<link rel="stylesheet" href="/styles/executive-theme.css" />
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<header class="links">
  <nav aria-label="Site navigation">
    <a href="/">← StackPilot AI</a>
    <a href="/compare/">Compare categories</a>
    {comparison && <a href={comparison.href}>{comparison.label}</a>}
    <a href="/methodology/">Methodology</a>
  </nav>
</header>
<main id="main">
<p>Independent introductory software profile</p>
<h1>{product.name}</h1>
<p>{product.description}</p>
<section aria-labelledby="overview">
<h2 id="overview">Overview</h2>
<p><strong>Category:</strong> {displayCategory}</p>
<p><strong>Research state:</strong> {!isExtended && product.researchStatus === 'verified' ? 'Editorially reviewed' : 'Research and editorial review pending'}</p>
{!isExtended && <p><strong>Potential use-case category:</strong> {product.bestFor.join(', ')}</p>}
<p class="alert">This listing is informational. Feature claims, pricing, team suitability, and service limitations have not been independently confirmed.</p>
</section>
<section aria-labelledby="fit">
<h2 id="fit">Fit and pricing</h2>
<p>Team-size suitability: {!isExtended && product.supportedTeams.length ? product.supportedTeams.join(', ') : 'Not yet verified'}</p>
<p>Budget compatibility: {!isExtended && product.budgetTiers.length ? product.budgetTiers.join(', ') : 'Not yet verified'}</p>
<p>Pricing: Consult the provider for current plans, currency, taxes, and limits. StackPilot AI has not verified pricing.</p>
</section>

<section aria-labelledby="verified-docs">
  <h2 id="verified-docs">First-party vendor documentation snapshot (checked {docsCheckedAt})</h2>
  <p>Owner-reviewed excerpts from {product.name}'s official documentation. Confirm current pricing, quotas, and contract terms directly via the linked official documentation.</p>
  <div class="table-scroll" role="region" tabindex="0" aria-label={`First-party vendor documentation snapshot for ${product.name}, scroll horizontally for all columns`}>
    <table>
      <thead>
        <tr>
          <th scope="col">Dimension</th>
          <th scope="col">Official documentation excerpt</th>
          <th scope="col">Primary source</th>
        </tr>
      </thead>
      <tbody>
        {!isExtended ? legacyVerifiedDocs.rows.map((row) => (
          <tr>
            <th scope="row"><strong>{row.dimension}</strong></th>
            <td>{row.entry.summary}</td>
            <td><a href={row.entry.sourceUrl} target="_blank" rel="noopener noreferrer">{row.entry.sourceLabel} ↗</a></td>
          </tr>
        )) : extendedDocsRows.map((row) => (
          <tr>
            <th scope="row"><strong>{row.dimension}</strong></th>
            <td>{row.summary}</td>
            <td><a href={row.sourceUrl} target="_blank" rel="noopener noreferrer">{row.sourceLabel} ↗</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

{isExtended && product.checklist.length > 0 && (
  <section aria-labelledby="buyer-checklist">
    <h2 id="buyer-checklist">Buyer verification checklist</h2>
    <ul>
      {product.checklist.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>
)}

{comparison && (
  <section aria-labelledby="comparison-links">
    <h2 id="comparison-links">Direct head-to-head comparison</h2>
    <p>Compare {product.name} directly against its primary category peer:</p>
    <p>👉 <a href={comparison.href}><strong>{comparison.label} Comparison Matrix</strong></a> — Side-by-side workflow breakdown and downloadable vendor due diligence questions.</p>
  </section>
)}

{isExtended && extendedComparisons.length > 0 && (
  <section aria-labelledby="comparison-links">
    <h2 id="comparison-links">Direct head-to-head comparisons</h2>
    <ul>
      {extendedComparisons.map((c) => (
        <li><a href={`/compare/${c.slug}/`}><strong>{c.title}</strong></a> — Side-by-side vendor documentation snapshot and buyer verification questions.</li>
      ))}
    </ul>
  </section>
)}

<section aria-labelledby="decision-tools">
  <h2 id="decision-tools">Related decision tools & guides</h2>
  <p>Run client-side modeling and plan migrations without server tracking:</p>
  <ul>
    {tools.map(tool => (
      <li><a href={tool.href}>{tool.title}</a> — {tool.desc}</li>
    ))}
    {guide && (
      <li><a href={guide.href}>{guide.title}</a> — Step-by-step buyer operational guide.</li>
    )}
  </ul>
</section>

<section aria-labelledby="sources">
<h2 id="sources">Research transparency</h2>
<p class="alert">The links below are <strong>unreviewed research leads</strong>. Their presence is not independent evidence of a verified feature, price, or product claim. The displayed date is when each source was logged for review, not a completed editorial approval.</p>
{!isExtended ? (product.sources.length ? <ul>{product.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.claim}</a> — candidate source logged {source.checkedAt} (not reviewed)</li>)}</ul> : <p>No approved research sources have been recorded yet.</p>) : (
  <ul>{product.officialUrls.map(url => <li><a href={url} target="_blank" rel="noopener noreferrer">{url}</a> — official vendor reference logged {docsCheckedAt}</li>)}</ul>
)}
<p>No affiliate tracking links are active. The link below opens the vendor's official site.</p>
<a href={product.website} target="_blank" rel="noopener noreferrer">Visit official website ↗</a>
</section>
</main>
<footer>© {new Date().getFullYear()} StackPilot AI. Recommendations are independent editorial starting points, not paid placements. <a href="/disclosure/">Disclosure</a> · <a href="/privacy/">Privacy</a></footer>
</body></html>